# ── Telegram ────────────────────────────────────────────────────────────
BOT_TOKEN=
BOT_USERNAME=

# Channel every user must join. Numeric id starting with -100.
# An invite link is NOT a chat_id — see README section B.
REQUIRED_CHANNEL_ID=-100xxxxxxxxxx
REQUIRED_CHANNEL_URL=https://t.me/your_channel

# ── Admin channels (three separate private channels) ────────────────────
# Registrations, habit/task/goal changes, subscription events.
ADMIN_LOG_CHANNEL_ID=-100xxxxxxxxxx
# Suggestions and complaints from 💬 Taklif. Falls back to ADMIN_LOG.
FEEDBACK_CHANNEL_ID=-100xxxxxxxxxx
# Daily aggregate usage numbers. Falls back to ADMIN_LOG.
STATS_CHANNEL_ID=-100xxxxxxxxxx
# The hour that post goes out, on the project clock. Default 10.
STATS_POST_HOUR=10

# ── Mini App ────────────────────────────────────────────────────────────
WEBAPP_URL=https://your-app.up.railway.app

# ── Database ────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/DATABASE

# ── Runtime ─────────────────────────────────────────────────────────────
ENVIRONMENT=production
TZ=Asia/Tashkent
INIT_DATA_MAX_AGE=86400

# Kanalga qo'shilish so'ralguncha nechta amal bepul (default 20).
# Yangi foydalanuvchidan eshikda obuna so'ralmaydi.
FREE_ACTIONS=20

# Obuna javobi necha sekund keshlanadi (default 600).
MEMBERSHIP_TTL=600

# Webhook rejimi. Bo'sh qoldirilsa bot polling bilan ishlaydi.
# WEBHOOK_URL berilsa, WEBHOOK_SECRET MAJBURIY (kamida 32 belgi, A-Z a-z 0-9 _ -).
# Usiz production jarayoni ishga tushmaydi. Yaratish:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# WEBHOOK_URL=https://sizning-domeningiz.com/webhook
# WEBHOOK_SECRET=

# ── Ernest voice agent (v12.2) ─────────────────────────────────────────────
# Never put a real key into Git or a chat. FFmpeg is required (Dockerfile has it).
# Audio accepted: 2 min / 10 MB maximum.
AGENT_ENABLED=false
# Speech → text, best Uzbek quality (Scribe v2). https://elevenlabs.io → API keys.
# Optional: without it Groq Whisper is used (weaker on Uzbek).
ELEVENLABS_API_KEY=
# Free tier: understands the text first; also the free speech fallback.
# https://console.groq.com/keys
GROQ_API_KEY=
# Paid overflow when Groq's free quota is used up. https://aistudio.google.com
# Turn on billing and set a budget alert there.
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-flash-latest
# Commands per user per day (default 30). Caps the AI bill per user.
AGENT_DAILY_REQUESTS=30

# ── Build identifier (v13.0) ──────────────────────────────────────────────
# Shown by GET /api/version. Railway sets RAILWAY_GIT_COMMIT_SHA by itself;
# elsewhere set BUILD_ID to the commit you deployed.
# BUILD_ID=
